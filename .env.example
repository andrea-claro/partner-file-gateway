# Local configuration for partner-file-gateway.
#
#   make secrets   copies this file to .env (chmod 600) and replaces every
#                  "<generated>" value with a random local-only secret.
#
# .env is gitignored. Never commit real values; add new variables here with a
# placeholder instead.

# LocalStack personal auth token (required). Free Hobby plan:
# https://app.localstack.cloud -> Settings -> Auth Tokens
LOCALSTACK_AUTH_TOKEN=<your-localstack-auth-token>

# SFTPGo admin account. The admin UI and REST API listen on 127.0.0.1 only.
SFTPGO_ADMIN_USERNAME=pfg-admin
SFTPGO_ADMIN_PASSWORD=<generated>

# Host port of the dashboard (always bound to 127.0.0.1). To publish it
# (optional), point a Cloudflare Tunnel route at http://localhost:<DASHBOARD_PORT>.
DASHBOARD_PORT=8000

# Optional: only needed if you run the bundled cloudflared container
# (make tunnel) instead of a tunnel that already runs on the host.
TUNNEL_TOKEN=<optional-cloudflare-tunnel-token>
